rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isTeacher() {
      return isSignedIn() && getUserData(request.auth.uid).role == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && getUserData(request.auth.uid).role == 'student';
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isLinkedStudent(userId) {
      return isSignedIn() && getUserData(userId).linkedUid == request.auth.uid;
    }

    // --- Validation Blueprints ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'role', 'name']) &&
             data.uid is string && data.uid.size() <= 256 &&
             data.role in ['teacher', 'student'] &&
             data.name is string && data.name.size() <= 100;
    }

    function isValidTopic(data) {
      return data.keys().hasAll(['title', 'order']) &&
             data.title is string && data.title.size() <= 100 &&
             data.order is number;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['topicId', 'title', 'order']) &&
             data.topicId is string &&
             data.title is string && data.title.size() <= 200 &&
             data.order is number;
    }

    function isValidMaterial(data) {
      return data.keys().hasAll(['categoryId', 'title', 'type', 'url']) &&
             data.categoryId is string &&
             data.title is string && data.title.size() <= 300 &&
             data.type is string &&
             data.url is string && data.url.size() <= 1000;
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['completed']) &&
             data.completed is bool;
    }

    function isValidSchedule(data) {
      return data.keys().hasAll(['title', 'time', 'teacherId']) &&
             data.title is string && data.title.size() <= 200 &&
             data.time is string && data.time.size() <= 50 &&
             data.teacherId is string;
    }

    // --- Match Rules ---

    // Users
    match /users/{userId} {
      allow get: if true; 
      allow list: if true; 

      allow create: if isSignedIn() && (isOwner(userId) || isTeacher());
      allow update: if (isSignedIn() && (isOwner(userId) || isTeacher())) || (existing().role == 'student');
      allow delete: if isTeacher();
    }

    // Topics, Categories, Materials
    match /topics/{id} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }
    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }
    match /materials/{id} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    // Schedules
    match /schedules/{id} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    // Submissions
    match /submissions/{submissionId} {
      allow read: if isTeacher() || (isSignedIn() && existing().studentId == request.auth.uid);
      allow create: if true; 
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // Attendance
    match /attendance/{date} {
      allow read, write: if isTeacher();
    }

    // Notifications
    match /notifications/{id} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    // Progress
    match /users/{userId}/progress/{lessonId} {
      allow read: if true;
      allow create, update: if isValidProgress(incoming());
      allow delete: if isTeacher();
    }

    // Material Types
    match /material_types/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacher();
    }
  }
}
